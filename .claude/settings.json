{
  "$comment": "Antaris-Guard repo policy for Claude Code. Commit as .claude/settings.json so every session inherits it. Deny wins over allow. Bash rules are prefix matches on the first command; the hooks under .claude/hooks judge the whole line. Adapted from Inventaris's settings with the AWS, cdk, Docker and Postgres lines removed, since this repository has none of those, and the browser-automation denies added.",

  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",

    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "LS",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(pwd)",

      "Bash(node:*)",
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm pack:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(git push origin HEAD)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git merge:*)",
      "Bash(npm publish:*)",
      "Bash(npm version:*)",
      "WebFetch",
      "WebSearch"
    ],

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.gitconfig)",
      "Read(/opt/pw-browsers/**)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(~/**)",
      "Edit(/.claude/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/**/CLAUDE.md)",
      "Edit(/.mcp.json)",

      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(crontab:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(export:*)",
      "Bash(eval:*)",
      "Bash(base64:*)",
      "Bash(xxd:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",

      "Bash(npx playwright:*)",
      "Bash(playwright:*)",
      "Bash(npx puppeteer:*)",
      "Bash(chromium:*)",
      "Bash(chromium-browser:*)",
      "Bash(google-chrome:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git branch -D:*)",
      "Bash(git clean:*)",
      "Bash(git config:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh repo delete:*)",

      "Bash(npx:*create-*)",
      "Bash(npm exec:*)",

      "Agent(fork)",
      "Workflow",
      "RemoteTrigger",
      "SendMessage",
      "ListAgents"
    ]
  },

  "crossSessionInbound": "refuse",

  "env": {
    "CI": "1",
    "NODE_ENV": "development",
    "DISABLE_TELEMETRY": "1",
    "PLAYWRIGHT_BROWSERS_PATH": "/nonexistent",
    "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1",

    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "3",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "1"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js"],
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/subagent-guard.js"],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
